# Не требуется для запуска и тестов. Ключ нужен для живых LLM-запросов.
OPENROUTER_API_KEY=
# Пустое значение тоже выбирает эту модель по умолчанию.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Локальный запуск (в Docker каталог данных всегда /data).
DATA_DIR=./data
# CONFIG_DIR по умолчанию равен DATA_DIR/config.
# Для раздачи локально собранного фронтенда: FRONTEND_DIR=frontend/dist.
# Docker уже задаёт FRONTEND_DIR=/app/frontend.

# Порт Docker на хосте. Для локального uvicorn задаётся флагом --port.
BACKEND_PORT=8000
