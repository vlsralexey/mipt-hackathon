# Не требуется для запуска каркаса. Ключ понадобится для живого поиска на этапе 2.
OPENROUTER_API_KEY=
# Идентификатор модели OpenRouter будет выбран при подключении LLM на этапе 1.
OPENROUTER_MODEL=

# Локальный запуск (в Docker каталог данных всегда /data).
DATA_DIR=./data
# CONFIG_DIR по умолчанию равен DATA_DIR/config.

# Порт Docker на хосте. Для локального uvicorn задаётся флагом --port.
BACKEND_PORT=8000
